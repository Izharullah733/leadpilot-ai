# Public browser configuration. Values are supplied by `supabase status -o env`
# for local development or by the hosted project settings for deployment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical HTTPS origin for hosted invitation links. Keep NEXT_PUBLIC_SITE_URL
# only as a backwards-compatible local alias.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local Stage 3 invitation delivery. Use a production mail provider when hosted.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325

# Server-only. Never expose this value through a NEXT_PUBLIC_ variable and
# never import it into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only optional AI assistance. AI remains disabled per company until an
# owner/admin accepts the data-minimization notice and enables it in Settings.
# Use `openai` for the real provider or `mock` only for deterministic local QA.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
AI_REQUEST_TIMEOUT_MS=30000
AI_MOCK_DEMO_ENABLED=

# Local/CI browser QA only. Never enable production mock mode for customers.
AI_ALLOW_MOCK_IN_PRODUCTION_TESTS=

# Operator-only hosted demo seed. Store real values in the git-ignored
# `.env.hosted-demo.local`, never in this template or in Vercel browser vars.
DEMO_SEED_ENABLED=
DEMO_ENVIRONMENT_NAME=
DEMO_SUPABASE_PROJECT_REF=
DEMO_DATABASE_URL=
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_MANAGER_EMAIL=
DEMO_MANAGER_PASSWORD=
DEMO_REP_EMAIL=
DEMO_REP_PASSWORD=

# Optional local/test-only passwords consumed by
# scripts/provision-local-auth-users.mjs. Use unique values and never commit
# actual passwords.
LOCAL_AHMED_PASSWORD=
LOCAL_SARA_PASSWORD=
LOCAL_USMAN_PASSWORD=
LOCAL_HIRA_PASSWORD=
LOCAL_NO_MEMBERSHIP_PASSWORD=
LOCAL_SUSPENDED_PASSWORD=
LOCAL_INVITEE_PASSWORD=

# Browser QA credentials. Keep values local and uncommitted. The local
# preparation script maps these to seeded Supabase Auth users.
QA_OWNER_EMAIL=
QA_OWNER_PASSWORD=
QA_REP_EMAIL=
QA_REP_PASSWORD=
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
QA_MANAGER_EMAIL=
QA_MANAGER_PASSWORD=
QA_INVITEE_EMAIL=
QA_INVITEE_PASSWORD=
QA_NO_MEMBERSHIP_EMAIL=
QA_NO_MEMBERSHIP_PASSWORD=
QA_SUSPENDED_EMAIL=
QA_SUSPENDED_PASSWORD=
